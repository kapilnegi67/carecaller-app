# Firebase Configuration
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_app_id

# OpenAI Configuration
EXPO_PUBLIC_OPENAI_API_KEY=your_openai_api_key_here

# VAPI Configuration
# Get your public key from: https://dashboard.vapi.ai/account
EXPO_PUBLIC_VAPI_PUBLIC_KEY=your_vapi_public_key_here
# Get your assistant ID from: https://dashboard.vapi.ai/assistants
EXPO_PUBLIC_VAPI_ASSISTANT_ID=your_vapi_assistant_id_here

# Backend Configuration
EXPO_PUBLIC_BACKEND_URL=http://localhost:3001
