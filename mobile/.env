# OpenAI API Configuration for AI Voice Conversations
# This key enables speech-to-text (Whisper) and text-to-speech functionality
# Replace with your actual OpenAI API key
EXPO_PUBLIC_OPENAI_API_KEY=${EXPO_PUBLIC_OPENAI_API_KEY}

# VAPI Configuration
# Get your public key from: https://dashboard.vapi.ai/account
EXPO_PUBLIC_VAPI_PUBLIC_KEY=your_vapi_public_key_here
# Get your assistant ID from: https://dashboard.vapi.ai/assistants
EXPO_PUBLIC_VAPI_ASSISTANT_ID=your_vapi_assistant_id_here
